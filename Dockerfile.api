FROM node:22-slim AS builder
WORKDIR /app
# Build deps: python3 + make + g++ for node-gyp (canvas/chartjs-node-canvas native addon)
# Cairo/Pango dev headers required to compile canvas from source
RUN apt-get update && apt-get install -y \
    python3 make g++ \
    libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev libpixman-1-dev \
    && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
WORKDIR /app
# Runtime deps: Cairo/Pango shared libs (no -dev headers needed at runtime)
RUN apt-get update && apt-get install -y curl sqlite3 libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libjpeg62-turbo libgif7 libpixman-1-0 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/migrations ./migrations
# Inter TTF fonts for Cyrillic PDF support
COPY --from=builder /app/server/fonts ./server/fonts
# SQLite db will be in /app/data mounted from host
RUN mkdir -p /app/data
# Keep WORKDIR as /app so process.cwd() == /app at runtime
ENV NODE_ENV=production
EXPOSE 5000
CMD ["node", "/app/dist/index.cjs"]
